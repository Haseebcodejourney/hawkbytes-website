# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Where contact form submissions are delivered
CONTACT_TO_EMAIL=info@hawkbytes.cloud

# Must be a verified domain sender in Resend (or onboarding@resend.dev for testing)
RESEND_FROM_EMAIL=HawkBytes <onboarding@resend.dev>

# Optional: dedicated secret for math captcha tokens (falls back to RESEND_API_KEY)
CAPTCHA_SECRET=change-me-to-a-long-random-string

# Optional chatbot AI. Without any key the chatbot answers from the site's own content.
# Add one or more free keys; they are tried in this order: Groq, Gemini, OpenRouter.
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional model overrides
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
